{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "client"] }
      },
      "required": ["uid", "email"]
    },
    "Client": {
      "title": "Client",
      "description": "Client managed by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "whatsapp": { "type": "string" },
        "plan": { "type": "string", "enum": ["Essencial", "Avançado", "Profissional"] },
        "status": { "type": "string", "enum": ["Em Desenvolvimento", "Ativo", "Inadimplente", "Cancelado"] },
        "createdAt": { "type": "number" },
        "email": { "type": "string", "format": "email" },
        "cpfCnpj": { "type": "string" }
      },
      "required": ["id", "name", "plan", "status", "createdAt"]
    },
    "SupportRequest": {
      "title": "Support Request",
      "description": "Support ticket created by a client",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["Aberto", "Em Andamento", "Concluído"] },
        "createdAt": { "type": "object" }
      },
      "required": ["id", "clientId", "subject", "message", "status"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Business expense logged by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "number" }
      },
      "required": ["id", "description", "amount", "category", "date"]
    },
    "Offer": {
      "title": "Offer",
      "description": "Product or service offer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["SUBSCRIPTION", "SINGLE"] },
        "price": { "type": "number" },
        "setupPrice": { "type": "number" },
        "maxInstallments": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "type", "price", "active", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/offers/{offerId}": {
      "schema": "Offer",
      "description": "Offers managed by the user"
    },
    "/users/{userId}/clients/{clientId}": {
      "schema": "Client",
      "description": "Clients managed by the user"
    },
    "/users/{userId}/supportRequests/{requestId}": {
      "schema": "SupportRequest",
      "description": "Support requests for the user's clients"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Business expenses for the user"
    },
    "/users/{userId}/settings/preferences": {
      "schema": "object",
      "description": "User application preferences"
    }
  }
}

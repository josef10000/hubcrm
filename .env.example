# ==============================================================================
# HUB CENTRAL - .env.example
# ==============================================================================
# Copie este arquivo para .env.local e preencha com seus valores reais.
# Variáveis VITE_* são públicas (disponíveis no frontend).
# Variáveis sem prefixo são privadas (disponíveis apenas no Backend/Vercel).
# ==============================================================================

# 🔥 FIREBASE CONFIGURATION (Frontend + Auth)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-id"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef..."

# 💳 ASAAS API (Pagamentos e Webhooks)
VITE_ASAAS_API_KEY="asaas_..." # Use sandbox para testes
# Token que você define no webhook do Asaas para validar a origem
ASAAS_WEBHOOK_TOKEN="seu_token_seguro"

# 📧 RESEND (E-mails Transacionais)
VITE_RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="onboarding@seu-dominio.com.br"

# ⚡ UPSTASH REDIS (Rate Limiting e Cache)
VITE_UPSTASH_REDIS_URL="https://seu-slug.upstash.io"
VITE_UPSTASH_REDIS_TOKEN="sua_token_aqui"

# 🤖 GEMINI AI (Opcional)
VITE_GEMINI_API_KEY="AIzaSy..."

# 🛰️ UPTIME ROBOT (Monitoramento)
VITE_UPTIMEROBOT_API_KEY="u12345-..."

# 🌐 APP SETTINGS
VITE_APP_URL="http://localhost:5173"
VITE_NODE_ENV="development"

# 🛠️ VERCEL SETTINGS (Backend Admin)
# Só necessário se usar funções administrativas via API Vercel
VERCEL_TOKEN="seu_token_aqui"
VERCEL_PROJECT_ID="prj_..."
VERCEL_TEAM_ID="team_..." # Se aplicável

# 🔩 CONFIGURAÇÕES ADICIONAIS
INVITE_EXPIRATION_HOURS=72

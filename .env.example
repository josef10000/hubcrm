# ==============================================================================
# HUB CENTRAL - .env.example
# ==============================================================================
# Copie este arquivo para .env.local e preencha com seus valores reais.
# Variáveis VITE_* são públicas (disponíveis no frontend).
# Variáveis sem prefixo são privadas (disponíveis apenas no Backend/Vercel).
# ==============================================================================

# 🔥 FIREBASE CONFIGURATION (Obtenha no Console do Firebase > Configurações do Projeto)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-id"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef..."

# 💳 ASAAS API (Pagamentos e Webhooks)
# Obtenha em Minha Conta > Integrações > Chaves de API
VITE_ASAAS_API_KEY="asaas_..." # Token para chamadas do Frontend/Backend
# Token que VOCÊ define no webhook do Asaas para validar se a requisição veio deles
ASAAS_WEBHOOK_TOKEN="seu_token_seguro_e_aleatorio"

# 📧 RESEND (E-mails Transacionais)
# Obtenha em resend.com > API Keys
VITE_RESEND_API_KEY="re_..."
# E-mail remetente validado no Resend (ex: onboarding@seudominio.com.br)
RESEND_FROM_EMAIL="notificacoes@hubsimples.com.br"

# ⚡ UPSTASH REDIS (Obrigatório para Rate Limiting na API)
# Obtenha em console.upstash.com
VITE_UPSTASH_REDIS_URL="https://seu-slug.upstash.io"
VITE_UPSTASH_REDIS_TOKEN="sua_token_aqui"

# ═══════════════════════════════════════════════════
# 🤖 SENTRY — Monitoramento de Erros (v3.7.0)
# ═══════════════════════════════════════════════════
VITE_SENTRY_DSN="https://sua-chave-aqui.sentry.io/projeto"

# ═══════════════════════════════════════════════════
# 🤖 GEMINI AI — Análise Inteligente (Opcional)
# Para inteligência de análise de dados
VITE_GEMINI_API_KEY="AIzaSy..."

# 🛰️ UPTIME ROBOT (Para o módulo de Monitoramento de Sites)
# Obtenha o Main API Key em uptimerobot.com > My Settings
VITE_UPTIMEROBOT_API_KEY="u12345-..."

# 🌐 APP SETTINGS
# URL base onde o app está rodando (importante para links de convite e e-mails)
VITE_APP_URL="http://localhost:5173"
VITE_NODE_ENV="development" # development ou production

# 🛠️ VERCEL SETTINGS (Apenas se for rodar deploys programáticos via API)
VERCEL_TOKEN="seu_token_aqui"
VERCEL_PROJECT_ID="prj_..."
VERCEL_TEAM_ID="team_..."

# 🔩 CONFIGURAÇÕES DE NEGÓCIO
# Tempo de validade do convite de novos membros
INVITE_EXPIRATION_HOURS=72

# ☁️ CLOUDFLARE R2 STORAGE CONFIGURATION
# Insira os dados do seu bucket R2 e credenciais para uploads assinados no chat/biblioteca
R2_ACCOUNT_ID="seu_account_id_do_cloudflare"
R2_ACCESS_KEY_ID="sua_access_key_id"
R2_SECRET_ACCESS_KEY="sua_secret_access_key"
R2_BUCKET_NAME="seu-bucket-name"
R2_PUBLIC_DOMAIN="https://storage.hubsymples.com.br"

# =============================================
# Hub Central - .env.example
# Copie este arquivo para .env.local e preencha com seus valores reais
# NUNCA commite o arquivo .env.local com chaves reais!
# =============================================

# =============================================
# FIREBASE (Frontend + Auth + Firestore)
# =============================================
VITE_FIREBASE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:xxxxxxxxxxxxxxxxxxxxxxxx

# =============================================
# ASAAS (Pagamentos, Assinaturas, Webhooks e Clientes)
# =============================================
# Chave da API (ambiente de produção ou sandbox)
VITE_ASAAS_API_KEY=asaas_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL base da API Asaas (use sandbox para testes)
# VITE_ASAAS_API_URL=https://api.asaas.com   # Produção
# VITE_ASAAS_API_URL=https://sandbox.asaas.com   # Sandbox (recomendado para dev)

# =============================================
# RESEND (E-mails transacionais - onboarding, alertas, etc.)
# =============================================
VITE_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# E-mail padrão usado como remetente (verifique no painel da Resend)
RESEND_FROM_EMAIL=contato@seusite.com.br

# =============================================
# UPSTASH REDIS (Rate limiting, fila de jobs, cache)
# =============================================
VITE_UPSTASH_REDIS_URL=https://xxxxxxxxxxxxx.upstash.io
VITE_UPSTASH_REDIS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================
# GEMINI AI (opcional - usado em automações de IA, qualificação de leads, etc.)
# =============================================
VITE_GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================
# OUTRAS CONFIGURAÇÕES (Frontend - Vite)
# =============================================

# URL pública do app (útil para links em e-mails e webhooks)
VITE_APP_URL=http://localhost:5173
# VITE_APP_URL=https://hubcrm-five.vercel.app   # Produção

# Ambiente (development | production | test)
VITE_NODE_ENV=development

# =============================================
# CONFIGURAÇÕES OPCIONAIS / AVANÇADAS
# =============================================

# UptimeRobot (Monitoramento de serviços dos clientes)
# VITE_UPTIMEROBOT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chave para assinatura digital ou outros serviços
# VITE_SIGNING_SECRET=super-secret-key-aqui

# Tempo de expiração de convites para equipe (em horas)
INVITE_EXPIRATION_HOURS=72

# =============================================
# INSTRUÇÕES
# =============================================
# 1. Copie este arquivo: cp .env.example .env.local
# 2. Preencha todas as chaves acima
# 3. Nunca commite arquivos .env.* com valores reais
# 4. Variáveis com prefixo VITE_ ficam disponíveis no frontend (import.meta.env)
# 5. Variáveis sem prefixo VITE_ ficam disponíveis apenas nas Serverless Functions (process.env)

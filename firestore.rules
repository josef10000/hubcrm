rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Funções de Ajuda (Helper Functions)
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // REGRA INFALÍVEL PARA O PROPRIETÁRIO
    function isOwnerEmail() {
      return isAuthenticated() && request.auth.token.email == 'jfs102019@hotmail.com';
    }
    
    // Busca o perfil do usuário logado no banco
    function getUserData() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    // Verifica se o usuário pertence à organização solicitada
    function belongsToOrg(orgId) {
      return isAuthenticated() && (isOwnerEmail() || getUserData().orgId == orgId);
    }

    // Verifica cargo (Role)
    function isOrgAdmin(orgId) {
      return belongsToOrg(orgId) && (isOwnerEmail() || getUserData().role == 'Administrador' || getUserData().role == 'Gerente');
    }

    // ===============================================================
    // Regras por Coleção
    // ===============================================================

    // Perfis Individuais
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerEmail() || request.auth.uid == userId;
    }

    // Organizações e seus dados (Multi-Tenant)
    match /organizations/{orgId} {
      allow read, write: if isOwnerEmail() || belongsToOrg(orgId);

      // Dados dentro da organização
      match /{collection}/{docId} {
        allow read: if isOwnerEmail() || belongsToOrg(orgId);
        allow write: if isOwnerEmail() || isOrgAdmin(orgId);
      }
    }

    // ===============================================================
    // Acesso Público (Checkout e Portal do Cliente)
    // ===============================================================
    
    // Acesso público para configurações básicas de checkout
    match /organizations/{orgId}/settings/preferences {
      allow read: if true;
    }

    match /organizations/{orgId}/offers/{offerId} {
      allow read: if true;
    }

    match /organizations/{orgId}/clients/{clientId} {
      allow get: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['npsScore', 'npsComment', 'npsSubmittedAt', 'stages', 'referralRewardType', 'currentDiscount']);
    }
    
    match /organizations/{orgId}/supportRequests/{requestId} {
      allow create, read: if true;
    }
  }
}

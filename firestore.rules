rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Funções de Ajuda (Helper Functions)
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Busca o perfil do usuário logado
    function getUserData() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    // Verifica se o usuário pertence à organização solicitada
    function belongsToOrg(orgId) {
      return isAuthenticated() && getUserData().orgId == orgId;
    }

    // Verifica cargo (Role)
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isOrgAdmin(orgId) {
      return belongsToOrg(orgId) && (getUserData().role == 'Administrador' || getUserData().role == 'Gerente');
    }

    // ===============================================================
    // Regras por Coleção
    // ===============================================================

    // Perfis Individuais
    match /profiles/{userId} {
      allow read: if isAuthenticated(); // Permitir leitura de perfis para exibição de nomes na equipe
      allow write: if request.auth.uid == userId;
    }

    // Organizações e seus dados (Multi-Tenant)
    match /organizations/{orgId} {
      allow read: if belongsToOrg(orgId);
      allow write: if isOrgAdmin(orgId);

      // Clientes dentro da organização
      match /clients/{clientId} {
        allow read: if belongsToOrg(orgId);
        allow write: if belongsToOrg(orgId) && getUserData().role != 'Só Leitura';
      }

      // Leads dentro da organização
      match /leads/{leadId} {
        allow read: if belongsToOrg(orgId);
        allow write: if belongsToOrg(orgId) && getUserData().role != 'Só Leitura';
      }

      // Outras coleções (Financeiro, Configurações, etc)
      match /{collection}/{docId} {
        allow read: if belongsToOrg(orgId);
        allow write: if isOrgAdmin(orgId);
      }
    }

    // ===============================================================
    // Acesso Público (Checkout e Portal do Cliente)
    // ===============================================================
    
    // Permitir leitura de configurações de checkout básico
    match /organizations/{orgId}/settings/preferences {
      allow read: if true;
    }

    // Permitir leitura de ofertas ativas para o checkout
    match /organizations/{orgId}/offers/{offerId} {
      allow read: if true;
    }

    // Permissões granulares para o Portal do Cliente (Sem login)
    match /organizations/{orgId}/clients/{clientId} {
      allow get: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['npsScore', 'npsComment', 'npsSubmittedAt', 'stages', 'referralRewardType', 'currentDiscount']);
    }
    
    match /organizations/{orgId}/supportRequests/{requestId} {
      allow create: if true; // Permitir que clientes enviem suporte do portal
      allow read: if true;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Funções de Ajuda (Helper Functions)
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // REGRA INFALÍVEL PARA O PROPRIETÁRIO
    function isOwnerEmail() {
      return isAuthenticated() && request.auth.token.email == 'jfs102019@hotmail.com';
    }
    
    // Busca o perfil do usuário logado no banco
    function getUserData() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    // Verifica se o usuário pertence à organização solicitada
    function belongsToOrg(orgId) {
      return isAuthenticated() && (isOwnerEmail() || getUserData().orgId == orgId);
    }

    // Verifica se o usuário tem uma permissão específica (Busca no cache do perfil ou no cargo)
    // Nota: O cache de 'permissions' no perfil evita o custo de get() extras em regras frequentes
    function hasPermission(orgId, perm) {
      let userData = getUserData();
      return isOwnerEmail() || 
             (userData.permissions != null && perm in userData.permissions) ||
             (userData.roleId != null && get(/databases/$(database)/documents/organizations/$(orgId)/roles/$(userData.roleId)).data.permissions.hasAny([perm]));
    }

    // Função legada para compatibilidade em áreas ainda não migradas 100%
    function isOrgAdmin(orgId) {
      return hasPermission(orgId, 'MANAGE_SETTINGS') || hasPermission(orgId, 'MANAGE_TEAM');
    }

    // ===============================================================
    // Regras por Coleção
    // ===============================================================

    // Perfis Individuais
    // Leitura: apenas o dono ou membros da mesma organização (necessário para chat, equipe, etc.)
    // Escrita genérica: apenas o próprio dono do perfil
    // Escrita administrativa: admin pode alterar apenas roleId e permissions de membros da sua org
    match /profiles/{userId} {
      allow read: if isOwnerEmail() || (request.auth != null && request.auth.uid == userId) || 
                    (isAuthenticated() && resource.data.orgId != null && resource.data.orgId == getUserData().orgId);
      
      // O próprio dono pode editar tudo no seu perfil
      allow write: if isOwnerEmail() || request.auth.uid == userId;
      
      // Admin da org pode alterar APENAS roleId e permissions (gestão de equipe)
      allow update: if isAuthenticated() && resource.data.orgId != null && 
                      isOrgAdmin(resource.data.orgId) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roleId', 'permissions', 'role', 'updatedAt']);

      // Subcoleção de Notas Pessoais — SOMENTE o dono pode ler/escrever
      match /notes/{noteId} {
        allow read, write: if isOwnerEmail() || request.auth.uid == userId;
      }

      // Subcoleção de Logs de Atividades — SOMENTE o dono pode ler/escrever
      match /activity_logs/{logId} {
        allow read, write: if isOwnerEmail() || request.auth.uid == userId;
      }
    }

    // Alertas do sistema (RBAC)
    match /system_alerts/{id} {
      allow read: if isAuthenticated() && (isOwnerEmail() || resource.data.orgId == getUserData().orgId);
    }

    // Organizações e seus dados (Multi-Tenant)
    match /organizations/{orgId} {
      allow read, write: if isOwnerEmail() || belongsToOrg(orgId);

      // Hub Canvas (agora dentro da organização)
      match /canvases/{canvasId} {
        allow read: if isOwnerEmail() || belongsToOrg(orgId);
        allow write: if isOwnerEmail() || belongsToOrg(orgId);
        
        match /records/{recordId} {
          allow read, write: if isOwnerEmail() || belongsToOrg(orgId);
        }
      }

      // 🟢 HUB CHAT — Regras de Colaboração em Tempo Real
      match /chats/{chatId} {
        // Membros podem ler o chat e atualizar dados de denormalização (lastMessage, unreadCount, etc)
        allow read, update: if isOwnerEmail() || (belongsToOrg(orgId) && request.auth.uid in resource.data.members);
        
        // Qualquer membro da organização pode iniciar um chat (DM, Grupo ou Meu Espaço)
        allow create: if isOwnerEmail() || belongsToOrg(orgId);
        
        // Mensagens: Apenas membros do chat pai podem ler e criar mensagens
        match /messages/{messageId} {
          allow read, create: if isOwnerEmail() || (belongsToOrg(orgId) && request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)/chats/$(chatId)).data.members);
          allow update: if isOwnerEmail() || (isAuthenticated() && request.auth.uid == resource.data.senderId);
        }
        
        // Typing Indicators: Apenas membros podem ver e sinalizar quem está digitando
        match /typing/{uid} {
          allow read, write: if isOwnerEmail() || (belongsToOrg(orgId) && request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)/chats/$(chatId)).data.members);
        }
      }

      // 🟢 HUB CHAT — Favoritos e Mídias do Usuário
      match /users/{userId}/bookmarks/{bookmarkId} {
        allow read, write: if isOwnerEmail() || (belongsToOrg(orgId) && request.auth.uid == userId);
      }

      match /users/{userId}/stickers/{stickerId} {
        allow read, write: if isOwnerEmail() || (belongsToOrg(orgId) && request.auth.uid == userId);
      }

      // Outros dados dentro da organização (Regras Granulares)

      // 🟢 HUB SHOP — Loja de Recompensas
      match /hubShopItems/{itemId} {
        allow read: if isOwnerEmail() || belongsToOrg(orgId);
        allow write: if isOwnerEmail() || isOrgAdmin(orgId);
      }

      match /hubShopOrders/{orderId} {
        allow read: if isOwnerEmail() || belongsToOrg(orgId) && (request.auth.uid == resource.data.userId || isOrgAdmin(orgId));
        allow create: if isOwnerEmail() || belongsToOrg(orgId) && request.auth.uid == request.resource.data.userId;
        allow update, delete: if isOwnerEmail() || isOrgAdmin(orgId);
      }

      // 📚 TRILHAS DE CONHECIMENTO — Nexus Core
      match /learningPaths/{pathId} {
        allow read: if isOwnerEmail() || belongsToOrg(orgId);
        allow write: if isOwnerEmail() || isOrgAdmin(orgId);
      }

      match /users/{userId}/learningPaths/{pathId} {
        allow read: if isOwnerEmail() || belongsToOrg(orgId);
        allow write: if isOwnerEmail() || (belongsToOrg(orgId) && request.auth.uid == userId);
      }

      match /transactions/{id} {
        allow read: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_FINANCE');
        allow write: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_FINANCE');
      }

      match /payrolls/{id} {
        allow read: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_FINANCE');
        allow write: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_FINANCE');
      }

      match /salary_advances/{id} {
        allow read: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_FINANCE') || (belongsToOrg(orgId) && resource.data.userId == request.auth.uid);
        allow write: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_FINANCE');
      }

      match /vacation_payments/{id} {
        allow read: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_FINANCE') || (belongsToOrg(orgId) && resource.data.userId == request.auth.uid);
        allow write: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_FINANCE');
      }

      match /clients/{id} {
        allow read: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_CLIENTS') || (belongsToOrg(orgId) && resource.data.assignedTo == request.auth.uid) || (isAuthenticated() && getUserData().clientId == id);
        allow get: if true;
        allow write: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_CLIENTS');
        allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['npsScore', 'npsComment', 'npsSubmittedAt', 'referralRewardType', 'currentDiscount', 'accessKey', 'portalLinked', 'portalEmail', 'portalUserUid', 'portalLinkedAt']);
      }

      match /leads/{id} {
        allow read: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_LEADS') || (belongsToOrg(orgId) && resource.data.assignedTo == request.auth.uid);
        allow write: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_LEADS');
      }

      match /wikiArticles/{id} {
        allow read: if belongsToOrg(orgId);
        allow write: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_WIKI');
      }

      match /roles/{id} {
        allow read: if belongsToOrg(orgId);
        allow write: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_SETTINGS');
      }

      match /team_invites/{id} {
        allow read, write: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_TEAM');
      }

      // Acesso Público a Ativos (Consulta individual via QR Code)
      match /assets/{assetId} {
        allow get: if true;
        allow list: if isOwnerEmail() || belongsToOrg(orgId);
        allow write: if isOwnerEmail() || isOrgAdmin(orgId) || hasPermission(orgId, 'MANAGE_TEAM');
      }
      
      // 🛡️ HUB COMPLIANCE — Ouvidoria e Linha Ética
      match /compliance_tickets/{ticketId} {
        allow create: if isOwnerEmail() || (
          belongsToOrg(orgId) && 
          (request.resource.data.isAnonymous == false || request.resource.data.userId == null)
        );
        allow get: if isOwnerEmail() || belongsToOrg(orgId);
        allow list, delete: if isOwnerEmail() || isOrgAdmin(orgId) || hasPermission(orgId, 'MANAGE_TEAM');
        allow update: if isOwnerEmail() || isOrgAdmin(orgId) || hasPermission(orgId, 'MANAGE_TEAM');
        
        match /messages/{messageId} {
          allow read, create: if isOwnerEmail() || belongsToOrg(orgId);
          allow delete: if isOwnerEmail() || isOrgAdmin(orgId) || hasPermission(orgId, 'MANAGE_TEAM');
        }
      }

      // 🟢 TEMPLATES DE PRODUÇÃO — Módulo de Templates de Sites e Prompts
      match /production_templates/{templateId} {
        allow read: if belongsToOrg(orgId);
        allow write: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_TEAM') || hasPermission(orgId, 'MANAGE_SETTINGS');
      }

      match /prompt_library/{promptId} {
        allow read: if belongsToOrg(orgId);
        allow write: if isOwnerEmail() || hasPermission(orgId, 'MANAGE_TEAM') || hasPermission(orgId, 'MANAGE_SETTINGS');
      }

      match /{collection}/{docId} {
        allow read: if isOwnerEmail() || belongsToOrg(orgId);
        allow write: if isOwnerEmail() || isOrgAdmin(orgId);

        // Sub-coleção de comentários da Wiki
        match /comments/{commentId} {
          allow read: if isOwnerEmail() || belongsToOrg(orgId);
          allow create: if isOwnerEmail() || belongsToOrg(orgId);
          allow delete: if isOwnerEmail() || isOrgAdmin(orgId) || request.auth.uid == resource.data.userId;
        }
      }

      // 🟢 AGENDA E SERVIÇOS DO CLIENTE
      match /appointments/{appointmentId} {
        allow read, write: if isOwnerEmail() || belongsToOrg(orgId);
      }

      match /client_services/{serviceId} {
        allow read, write: if isOwnerEmail() || belongsToOrg(orgId);
      }

      // 🟢 CONTROLE FINANCEIRO (DESPESAS E RECEITAS MANUAIS)
      match /expenses/{expenseId} {
        allow read, write: if isOwnerEmail() || belongsToOrg(orgId);
      }

      match /revenues/{revenueId} {
        allow read, write: if isOwnerEmail() || belongsToOrg(orgId);
      }
    }

    // ===============================================================
    // Acesso Público (Checkout e Portal do Cliente)
    // ===============================================================
    
    // Configurações de Branding e Preferências (Público para renderizar Checkout/Portal)
    match /organizations/{orgId}/settings/preferences {
      allow read: if true;
    }

    // Ofertas e Planos Disponíveis (Público para o Checkout)
    match /organizations/{orgId}/offers/{offerId} {
      allow read: if true;
    }
    
    // Suporte (Portal do Cliente)
    match /organizations/{orgId}/supportRequests/{requestId} {
      // Público pode criar chamados, mas apenas a equipe (ou via ID específico se implementado) pode ler
      allow create: if true;
      allow read: if belongsToOrg(orgId);
    }

    // Propostas Comerciais (Root Collection)
    match /proposals/{proposalId} {
      // Leitura pública permitida para o link da proposta funcionar
      allow get: if true;
      // Listagem permitida apenas para membros da organização
      allow list: if isAuthenticated() && (isOwnerEmail() || resource.data.orgId == getUserData().orgId);
      // Criação permitida apenas para membros da organização
      allow create: if isAuthenticated() && (isOwnerEmail() || request.resource.data.orgId == getUserData().orgId);
      // Atualização permitida para membros da organização OU pelo cliente (apenas campos de aceite)
      allow update: if (isAuthenticated() && (isOwnerEmail() || resource.data.orgId == getUserData().orgId)) ||
                     (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'viewedAt', 'approvedAt', 'acceptanceMetadata', 'items', 'totalAmount']));
    }
  }
}
// Trigger deploy test to verify new GCP permissions

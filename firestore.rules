rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Funções de Ajuda (Helper Functions)
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // REGRA INFALÍVEL PARA O PROPRIETÁRIO
    function isOwnerEmail() {
      return isAuthenticated() && request.auth.token.email == 'jfs102019@hotmail.com';
    }
    
    // Busca o perfil do usuário logado no banco
    function getUserData() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    // Verifica se o usuário pertence à organização solicitada
    function belongsToOrg(orgId) {
      return isAuthenticated() && (isOwnerEmail() || getUserData().orgId == orgId);
    }

    // Verifica cargo (Role)
    function isOrgAdmin(orgId) {
      return belongsToOrg(orgId) && (isOwnerEmail() || getUserData().role == 'Administrador' || getUserData().role == 'Gerente' || getUserData().role == 'People & Culture');
    }

    // ===============================================================
    // Regras por Coleção
    // ===============================================================

    // Perfis Individuais
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerEmail() || request.auth.uid == userId || isOrgAdmin(getUserData().orgId);
    }

    // Organizações e seus dados (Multi-Tenant)
    match /organizations/{orgId} {
      allow read, write: if isOwnerEmail() || belongsToOrg(orgId);

      // Dados dentro da organização
      match /{collection}/{docId} {
        allow read: if isOwnerEmail() || belongsToOrg(orgId);
        allow write: if isOwnerEmail() || isOrgAdmin(orgId);

        // Sub-coleção de comentários da Wiki (acessível por todos os membros para criar/deletar próprio)
        match /comments/{commentId} {
          allow read: if isOwnerEmail() || belongsToOrg(orgId);
          allow create: if isOwnerEmail() || belongsToOrg(orgId);
          allow delete: if isOwnerEmail() || isOrgAdmin(orgId) || request.auth.uid == resource.data.userId;
        }
      }
    }

    // ===============================================================
    // Acesso Público (Checkout e Portal do Cliente)
    // ===============================================================
    
    // Configurações de Branding e Preferências (Público para renderizar Checkout/Portal)
    match /organizations/{orgId}/settings/preferences {
      allow read: if true;
    }

    // Ofertas e Planos Disponíveis (Público para o Checkout)
    match /organizations/{orgId}/offers/{offerId} {
      allow read: if true;
    }

    // Portal do Cliente
    match /organizations/{orgId}/clients/{clientId} {
      // Permite buscar um cliente específico pelo ID (chave de acesso do portal)
      // Não permite listar (list) todos os clientes da empresa
      allow get: if true;
      
      // Permite que o cliente atualize apenas campos específicos de interação no portal
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['npsScore', 'npsComment', 'npsSubmittedAt', 'referralRewardType', 'currentDiscount', 'accessKey']);
    }
    
    // Suporte (Portal do Cliente)
    match /organizations/{orgId}/supportRequests/{requestId} {
      // Público pode criar chamados, mas apenas a equipe (ou via ID específico se implementado) pode ler
      allow create: if true;
      allow read: if belongsToOrg(orgId);
    }
  }
}
// Trigger deploy test to verify new GCP permissions
